    method RandomPoints(count: number, generator: QuarkRandomGenerator?): (Vector | Vector2D)[]
    method ClosestPoint(point: Vector | { [string]: any } | number[]): Vector | Vector2D
    method Distance(point: Vector | { [string]: any } | number[]): number
