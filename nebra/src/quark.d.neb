    --- @return allowed
    --- @return retry_after_or_message
    --- @return remaining
    function Check(key: string | number, cost: number?, callback: function?): (boolean?, number | string?, number?)
    --- @return message
    function Reset(key: string | number, callback: function?): (boolean?, string?)
end

@side(server)
declare interface QuarkRateLimitModule
