@side(server)
declare class QuarkKDTree
    function FindNearest(position: Vector | { X: number, Y: number, Z: number? } | number[], options: { Count: number?, MaxDistance: number?, WithDistance: boolean? }?): { [any]: any }
    function QueryRadius(position: Vector | { X: number, Y: number, Z: number? } | number[], radius: number, options: { WithDistance: boolean? }?): { [any]: any }
