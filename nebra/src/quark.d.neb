    function IsSuccess(): boolean
end

--- Events: Response(status, headers, url), Data(chunk), End, Error(message), Close(reason).
@side(server)
declare class QuarkHTTPStream extends QuarkConnection
    function Close(): void
end

@side(server)
declare interface QuarkHTTPModule
    --- @return message
    function Listen(port: number, options: ({ Host: string?, MaxBodySize: number?, Timeout: (number | string)?, MaxConnections: number?, MaxMessageSize: number?, TLS: { Certificate: string, PrivateKey: string, ClientCA: string?, RequireClientCertificate: boolean? }?, Compression: (boolean | { Encodings: string[]?, MinSize: number?, Level: number? })?, HTTP2: boolean? })?): (QuarkHTTPServer?, string?)
    --- CORS middleware for HTTPServer:Use.
    function Cors(options: ({ Origin: (string | string[])?, Methods: string?, Headers: string?, Credentials: boolean?, MaxAge: number? })?): function
    --- @return message
    function Request(options: { URL: string?, Method: string?, Headers: { [string]: string }?, Query: { [any]: any }?, Body: (string | QuarkBuffer)?, Json: any, Timeout: (number | string)?, MaxBodySize: number?, FollowRedirects: boolean?, MaxRedirects: number?, CA: string?, Certificate: string?, PrivateKey: string?, Decompress: boolean?, HTTP2: boolean? }, callback: function?): (QuarkHTTPClientResponse?, string?)
    --- @return message
    function Get(url: string, options: ({ URL: string?, Method: string?, Headers: { [string]: string }?, Query: { [any]: any }?, Body: (string | QuarkBuffer)?, Json: any, Timeout: (number | string)?, MaxBodySize: number?, FollowRedirects: boolean?, MaxRedirects: number?, CA: string?, Certificate: string?, PrivateKey: string?, Decompress: boolean?, HTTP2: boolean? })?, callback: function?): (QuarkHTTPClientResponse?, string?)
    --- @return message
    function Post(url: string, body: any, options: ({ URL: string?, Method: string?, Headers: { [string]: string }?, Query: { [any]: any }?, Body: (string | QuarkBuffer)?, Json: any, Timeout: (number | string)?, MaxBodySize: number?, FollowRedirects: boolean?, MaxRedirects: number?, CA: string?, Certificate: string?, PrivateKey: string?, Decompress: boolean?, HTTP2: boolean? })?, callback: function?): (QuarkHTTPClientResponse?, string?)
    function Stream(options: { URL: string?, Method: string?, Headers: { [string]: string }?, Query: { [any]: any }?, Body: (string | QuarkBuffer)?, Json: any, Timeout: (number | string)?, MaxBodySize: number?, FollowRedirects: boolean?, MaxRedirects: number?, CA: string?, Certificate: string?, PrivateKey: string?, Decompress: boolean?, HTTP2: boolean? }): QuarkHTTPStream
end

