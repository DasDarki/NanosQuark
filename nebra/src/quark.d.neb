    function PointInPolygon(point: Vector | { X: number, Y: number, Z: number? } | number[], polygon: (Vector | { X: number, Y: number, Z: number? } | number[])[]): boolean
    function PolygonArea(polygon: (Vector | { X: number, Y: number, Z: number? } | number[])[], signed: boolean?): number
    function PolygonCentroid(polygon: (Vector | { X: number, Y: number, Z: number? } | number[])[]): Vector2D
    function ConvexHull(points: (Vector | { X: number, Y: number, Z: number? } | number[])[]): Vector2D[]
    function SegmentIntersection(a1: Vector | { X: number, Y: number, Z: number? } | number[], a2: Vector | { X: number, Y: number, Z: number? } | number[], b1: Vector | { X: number, Y: number, Z: number? } | number[], b2: Vector | { X: number, Y: number, Z: number? } | number[]): Vector2D?
    function ClosestPointOnSegment(point: Vector | { X: number, Y: number, Z: number? } | number[], start: Vector | { X: number, Y: number, Z: number? } | number[], finish: Vector | { X: number, Y: number, Z: number? } | number[]): Vector
    function DistanceToSegment(point: Vector | { X: number, Y: number, Z: number? } | number[], start: Vector | { X: number, Y: number, Z: number? } | number[], finish: Vector | { X: number, Y: number, Z: number? } | number[]): number
    function Triangulate(polygon: (Vector | { X: number, Y: number, Z: number? } | number[])[]): number[][]
    function Delaunay(points: (Vector | { X: number, Y: number, Z: number? } | number[])[]): number[][]
    function SimplifyPath(points: (Vector | { X: number, Y: number, Z: number? } | number[])[], tolerance: number): Vector[]
    --- @return minimum
    --- @return maximum
    function BoundingBox(points: (Vector | { X: number, Y: number, Z: number? } | number[])[], options: { Padding: number? }?): (Vector?, Vector?)
end

