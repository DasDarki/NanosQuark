    --- Returns a module, raises an error if it does not exist.
    function Import(name: string): { [any]: any }
    --- Names of all available modules.
    function Modules(): string[]
    --- Monotonic time in seconds with sub millisecond precision.
    function Clock(): number
    --- Runs a function as a coroutine in which `Quark.Await` can be used.
    function Async(body: (...any) -> ...any, ...: any): QuarkPromise
    --- Waits for a promise or calls a callback style function and waits for its result. Only inside `Quark.Async`.
    function Await(target: QuarkPromise | function, ...: any): ...any
    --- Promise resolving after the delay.
    function Delay(milliseconds: number): QuarkPromise
    --- Sets the configuration once, see docs/configuration.md.
    function Configure(options: { TickBudget: number?, WorkerThreads: number?, BlockingThreads: number?, Network: ({ AllowConnect: string[]?, AllowListen: ((number | string)[])? })? }): void
    --- The current configuration.
    function GetConfiguration(): { TickBudget: number, WorkerThreads: number, BlockingThreads: number, Locked: boolean, Source: string?, Network: { AllowConnect: string[]?, AllowListen: string[]? } }
end

--- Handle of asynchronous work started with a callback.
@side(server)
declare class QuarkTask
