@side(server)
declare interface QuarkProcGenModule
    Tile: { Wall: number, Floor: number, Corridor: number, Door: number }
    function Caves(width: number, height: number, options: { FillChance: number?, Steps: number?, BirthLimit: number?, DeathLimit: number?, KeepLargest: boolean?, Generator: QuarkRandomGenerator? }?): QuarkMap
    function Dungeon(width: number, height: number, options: { Attempts: number?, MinRoomSize: number?, MaxRoomSize: number?, Loops: number?, Doors: boolean?, Generator: QuarkRandomGenerator? }?): QuarkMap
    function Heightmap(width: number, height: number, options: { [any]: any }?, callback: function?): QuarkBuffer
end

--- Seeded generator, the same seed gives the same sequence everywhere.
@side(server)
declare class QuarkRandomGenerator
    --- Integer from minimum to maximum, both inclusive. With one argument from 1 to it.
    function Int(minimum_or_maximum: number, maximum: number?): number
    --- Number from 0 to 1, 0 to maximum or minimum to maximum, the upper end is excluded.
    function Float(minimum_or_maximum: number?, maximum: number?): number
    function Bool(probability: number?): boolean
    --- @return index
    function Pick(list: any[]): (any, number?)
    --- Shuffles in place and returns the list.
    function Shuffle(list: any[]): any[]
    --- Distinct elements without replacement.
    function Sample(list: any[], count: number): any[]
    --- One item picked by weight.
    function Weighted(weights: { [any]: any }): any
    function Normal(mean: number?, deviation: number?): number
    function Exponential(rate: number?): number
    function Poisson(mean: number): number
    function Triangular(minimum: number, maximum: number, mode: number?): number
    --- @return x
    --- @return y
    function InsideCircle(radius: number?): (number, number)
    --- @return x
    --- @return y
    --- @return z
    function InsideSphere(radius: number?): (number, number, number)
    --- @return x
    --- @return y
    --- @return z
    function OnSphere(radius: number?): (number, number, number)
    --- Dice notation like "2d6+3" or "4d6kh3".
    --- @return total
    --- @return rolls
    function Roll(notation: string): (number, number[])
    function GetSeed(): number
    function GetState(): string
    function SetState(state: string): void
    function Clone(): QuarkRandomGenerator
end

@side(server)
declare class QuarkWeightedPicker
    function Pick(generator: QuarkRandomGenerator?): any
    function PickMany(count: number, generator: QuarkRandomGenerator?): any[]
    function GetProbability(item: any): number
    function GetItems(): { Item: any, Weight: number }[]
    function GetCount(): number
    function GetTotalWeight(): number
end

@side(server)
declare class QuarkLootTable
    function Roll(options: { Generator: QuarkRandomGenerator?, Merge: boolean?, Pity: { [any]: any }? }?): { Item: any, Count: number }[]
    function GetChance(item: any): number
end

--- Coherent noise for terrain, distributions and movement.
@side(server)
declare class QuarkNoise
    function Get(x: number, y: number, z: number?): number
    --- @return x
    --- @return y
    --- @return z
    function Warp(x: number, y: number, z: number?): (number, number, number?)
    --- Grid of little endian f32 values, row by row.
    function Fill(width: number, height: number, options: { X: number?, Y: number?, Z: number?, Step: number? }?, callback: function?): QuarkBuffer
end

@side(server)
declare interface QuarkRandomModule
    --- Integer from minimum to maximum, both inclusive. With one argument from 1 to it.
    function Int(minimum_or_maximum: number, maximum: number?): number
    --- Number from 0 to 1, 0 to maximum or minimum to maximum, the upper end is excluded.
    function Float(minimum_or_maximum: number?, maximum: number?): number
    function Bool(probability: number?): boolean
    --- @return index
    function Pick(list: any[]): (any, number?)
    --- Shuffles in place and returns the list.
    function Shuffle(list: any[]): any[]
    --- Distinct elements without replacement.
    function Sample(list: any[], count: number): any[]
    --- One item picked by weight.
    function Weighted(weights: { [any]: any }): any
    function Normal(mean: number?, deviation: number?): number
    function Exponential(rate: number?): number
    function Poisson(mean: number): number
    function Triangular(minimum: number, maximum: number, mode: number?): number
    --- @return x
    --- @return y
    function InsideCircle(radius: number?): (number, number)
    --- @return x
    --- @return y
    --- @return z
    function InsideSphere(radius: number?): (number, number, number)
    --- @return x
    --- @return y
    --- @return z
    function OnSphere(radius: number?): (number, number, number)
    --- Dice notation like "2d6+3" or "4d6kh3".
    --- @return total
    --- @return rolls
    function Roll(notation: string): (number, number[])
    function New(seed: (number | string)?): QuarkRandomGenerator
    --- Reseeds the default generator of the package.
    function Seed(seed: (number | string)?): number
    function GetDefault(): QuarkRandomGenerator
    function HashSeed(text: string): number
    function IsGenerator(value: any): boolean
    function WeightedPicker(weights: { [any]: any }): QuarkWeightedPicker
    function LootTable(definition: { Rolls: (number | number[])?, Entries: { [any]: any }[]?, Guaranteed: { [any]: any }[]?, Pity: { Item: any, After: number, Key: any }[]? }): QuarkLootTable
    function Noise(options: ({ Seed: (number | string)?, Type: string?, Frequency: number?, Fractal: string?, Octaves: number?, Lacunarity: number?, Gain: number?, WeightedStrength: number?, PingPongStrength: number?, CellularDistance: string?, CellularReturn: string?, CellularJitter: number?, Warp: (boolean | { [any]: any })? })?): QuarkNoise
    function PoissonDisk(width: number, height: number, radius: number, options: ({ X: number?, Y: number?, Filter: ((number, number) -> boolean)?, Limit: number?, Attempts: number?, Generator: QuarkRandomGenerator? })?): { X: number, Y: number }[]
end

--- Redis client, every method takes an optional callback as last argument.
@side(server)
declare class QuarkRedisClient
    --- Any Redis command.
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function Command(name: string, ...: any): (any, string?)
    --- @return message
    function Get(key: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    function Set(key: string | number | QuarkBuffer, value: string | number | QuarkBuffer, options: { EX: number?, PX: number?, NX: boolean?, XX: boolean?, KeepTTL: boolean? }?, callback: function?): (boolean?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function Delete(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    function Exists(key: string | number | QuarkBuffer, callback: function?): (boolean?, string?)
    --- @return message
    function Expire(key: string | number | QuarkBuffer, seconds: number, callback: function?): (boolean?, string?)
    --- @return message
    function TTL(key: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @return message
    function Increment(key: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @return message
    function Decrement(key: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @return message
    function HashGet(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    function HashSet(key: string | number | QuarkBuffer, field_or_fields: string | number | QuarkBuffer | { [any]: any }, value: (string | number | QuarkBuffer)?, callback: function?): (number?, string?)
    --- @return message
    function HashGetAll(key: string | number | QuarkBuffer, callback: function?): ({ [string]: string }?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function HashDelete(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    function HashExists(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, callback: function?): (boolean?, string?)
    --- @return message
    function HashIncrement(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function ListPush(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function ListPushFront(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    function ListPop(key: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    function ListPopBack(key: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    function ListRange(key: string | number | QuarkBuffer, start: number, stop: number, callback: function?): (string[]?, string?)
    --- @return message
    function ListLength(key: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function SetAdd(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function SetRemove(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    function SetMembers(key: string | number | QuarkBuffer, callback: function?): (string[]?, string?)
    --- @return message
    function SetContains(key: string | number | QuarkBuffer, member: string | number | QuarkBuffer, callback: function?): (boolean?, string?)
    --- @return message
    function SortedSetAdd(key: string | number | QuarkBuffer, member: string | number | QuarkBuffer, score: number, callback: function?): (number?, string?)
    --- @return message
    function SortedSetIncrement(key: string | number | QuarkBuffer, member: string | number | QuarkBuffer, by: number, callback: function?): (number?, string?)
    --- @return message
    function SortedSetScore(key: string | number | QuarkBuffer, member: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @return message
    function SortedSetRank(key: string | number | QuarkBuffer, member: string | number | QuarkBuffer, options: { Reverse: boolean? }?, callback: function?): (number?, string?)
    --- @return message
    function SortedSetRange(key: string | number | QuarkBuffer, start: number, stop: number, options: { Reverse: boolean?, WithScores: boolean? }?, callback: function?): ({ [any]: any }?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function SortedSetRemove(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    function SortedSetCount(key: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @return message
    function Publish(channel: string, message: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @return message
    function Pipeline(commands: { [any]: any }[], options: { Atomic: boolean? }?, callback: function?): (any[]?, string?)
    --- @return message
    function StreamAdd(key: string | number | QuarkBuffer, fields: { [any]: any }, options: { ID: string?, MaxLength: number?, Approximate: boolean? }?, callback: function?): (string?, string?)
    --- @return message
    function StreamRange(key: string | number | QuarkBuffer, start: string?, stop: string?, options: { Count: number?, Reverse: boolean? }?, callback: function?): ({ ID: string, Fields: { [string]: string } }[]?, string?)
    --- @return message
    function StreamRead(streams: { [string]: string }, options: ({ Count: number?, Block: (number | string)? })?, callback: function?): ({ [string]: { ID: string, Fields: { [string]: string } }[] }?, string?)
    --- @return message
    function StreamLength(key: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function StreamDelete(key: string | number | QuarkBuffer, id: string, ...: any): (number?, string?)
    --- @return message
    function StreamTrim(key: string | number | QuarkBuffer, max_length: number, options: { Approximate: boolean? }?, callback: function?): (number?, string?)
    --- @return message
    function StreamCreateGroup(key: string | number | QuarkBuffer, group: string, options: { ID: string?, MakeStream: boolean? }?, callback: function?): (boolean?, string?)
    --- @return message
    function StreamReadGroup(group: string, consumer: string, streams: { [any]: any } | string[], options: ({ Count: number?, Block: (number | string)?, NoAck: boolean? })?, callback: function?): ({ [string]: { ID: string, Fields: { [string]: string } }[] }?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    function StreamAck(key: string | number | QuarkBuffer, group: string, id: string, ...: any): (number?, string?)
    --- @return message
    function StreamPending(key: string | number | QuarkBuffer, group: string, callback: function?): ({ Count: number, First: string?, Last: string?, Consumers: { [string]: number } }?, string?)
    --- @return message
    function StreamClaim(key: string | number | QuarkBuffer, group: string, consumer: string, min_idle: number, options: { Start: string?, Count: number? }?, callback: function?): ({ Entries: { ID: string, Fields: { [string]: string } }[], Next: string }?, string?)
    function IsClosed(): boolean
    function Close(): void
end

--- Events: Connect, Message(channel, message, pattern), Disconnect(reason), Error(message), Close(reason).
@side(server)
declare class QuarkRedisSubscriber extends QuarkEmitter
    function Listen(channel: string, ...: string): void
    function Unlisten(channel: string, ...: string): void
    function ListenPattern(channel: string, ...: string): void
    function UnlistenPattern(channel: string, ...: string): void
    function GetChannels(): string[]
    function GetPatterns(): string[]
    function GetState(): string
    function IsOpen(): boolean
    function Close(): void
end

--- Events: Entry(stream, id, fields), Connect, Disconnect(reason), Error(message), Close(reason).
@side(server)
declare class QuarkRedisStreamReader extends QuarkEmitter
    function GetState(): string
    function IsOpen(): boolean
    function Close(): void
end

@side(server)
declare interface QuarkRedisModule
    function Connect(target: (string | string[] | { Sentinels: string[], MasterName: string })?, options: ({ Username: string?, Password: string?, Database: number?, Timeout: (number | string)?, Retries: number?, CA: string?, TLS: boolean?, ReadFromReplicas: boolean? })?): QuarkRedisClient
    function Subscriber(target: (string | string[] | { Sentinels: string[], MasterName: string })?, options: ({ Username: string?, Password: string?, Database: number?, Timeout: (number | string)?, Retries: number?, CA: string?, TLS: boolean?, ReadFromReplicas: boolean? })?): QuarkRedisSubscriber
    function StreamReader(target: string | string[] | { Sentinels: string[], MasterName: string }, options: { Streams: string | string[], Start: string?, Group: string?, Consumer: string?, CreateGroup: boolean?, AutoAck: boolean?, Count: number?, Block: (number | string)?, Username: string?, Password: string?, Database: number?, Timeout: (number | string)?, CA: string? }): QuarkRedisStreamReader
end

@side(server)
declare class QuarkFlowField
    --- @return dx
    --- @return dy
    function GetDirection(x: number, y: number): (number, number)
    function GetDistance(x: number, y: number): number?
    function GetPath(x: number, y: number): { X: number, Y: number }[]?
    function IsReachable(x: number, y: number): boolean
end

--- Pathfinding grid.
@side(server)
declare class QuarkGrid
    --- @return width
    --- @return height
    function GetSize(): (number, number)
    function SetBlocked(x: number, y: number, blocked: boolean?): void
    function IsBlocked(x: number, y: number): boolean
    function SetCost(x: number, y: number, cost: number | boolean): void
    function GetCost(x: number, y: number): number?
    function Fill(cost: number | boolean): void
    function FillRect(x1: number, y1: number, x2: number, y2: number, cost: number | boolean): void
    function LoadCosts(values: number[] | QuarkBufferView): void
    --- @return cost_or_message
    function FindPath(from: { X: number, Y: number }, to: { X: number, Y: number }, options: { Algorithm: string?, MaxNodes: number?, Smooth: boolean? }?, callback: function?): ({ X: number, Y: number }[]?, number | string?)
    function FlowField(goals: { X: number, Y: number } | { X: number, Y: number }[], options: { MaxCost: number? }?, callback: function?): QuarkFlowField
    function HasLineOfSight(from: { X: number, Y: number }, to: { X: number, Y: number }): boolean
    --- @return x
    --- @return y
    --- @return inside
    function ToCell(position: Vector | { X: number, Y: number, Z: number? } | number[]): (number, number, boolean)
    function ToWorld(x: number, y: number, z: number?): Vector
    function Clone(): QuarkGrid
end

--- Navigation graph.
@side(server)
declare class QuarkGraph
    function AddNode(id: number | string, position: (Vector | { X: number, Y: number, Z: number? } | number[])?): void
    function RemoveNode(id: number | string): boolean
    function AddEdge(from: number | string, to: number | string, cost: number?, options: { Bidirectional: boolean? }?): void
    function RemoveEdge(from: number | string, to: number | string, both: boolean?): void
