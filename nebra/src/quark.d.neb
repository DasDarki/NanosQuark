--- A request received by an HTTP server.
@side(server)
declare class QuarkHTTPRequest
    Method: string
    Path: string
    Params: { [string]: string }
    Query: { [string]: string }
    RawQuery: string
    Headers: { [string]: string }
    Body: string
    Cookies: { [string]: string }
    RemoteAddress: string
    IsWebSocket: boolean
    Version: string
    ClientCertificate: QuarkPeerCertificate?
    --- @return message
    function Json(): (any, string?)
    --- @return fields
    --- @return files_or_message
    function Form(): ({ [any]: any }?, { [any]: any } | string?)
    function GetHeader(name: string): string?
end

--- Response of an HTTP handler.
@side(server)
declare class QuarkHTTPResponse
    function Status(code: number): QuarkHTTPResponse
    function Header(name: string, value: string): QuarkHTTPResponse
    function Json(value: any, status: number?): boolean
    function Text(text: string, status: number?): boolean
    function Html(html: string, status: number?): boolean
    function Send(body: (string | QuarkBuffer)?, content_type: string?, status: number?): boolean
    function Redirect(location: string, status: number?): boolean
    function SendFile(path: string, options: { MaxAge: number?, ContentType: string?, MaxFileSize: number? }?): boolean
    function Cookie(name: string, value: string, options: { MaxAge: number?, Path: string?, Domain: string?, Secure: boolean?, HttpOnly: boolean?, SameSite: string? }?): QuarkHTTPResponse
    function ClearCookie(name: string, options: { Path: string?, Domain: string? }?): QuarkHTTPResponse
    function Compress(enabled: boolean?): QuarkHTTPResponse
    function IsSent(): boolean
    function GetStatus(): number
end

--- Events: Error(message), Close(reason).
@side(server)
declare class QuarkHTTPServer extends QuarkConnection
    function Get(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Post(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Put(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Patch(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Delete(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Options(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function All(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function Route(method: string, pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    function WebSocket(pattern: string, handler: (QuarkWebSocket, QuarkHTTPRequest) -> void): QuarkHTTPServer
    function Static(prefix: string, directory: string, options: { Index: string?, MaxAge: number? }?): QuarkHTTPServer
    function Use(middleware: (QuarkHTTPRequest, QuarkHTTPResponse, () -> void) -> void): QuarkHTTPServer
    function GetPort(): number
    function Close(): void
end

