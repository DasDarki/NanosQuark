--- Seeded generator, the same seed gives the same sequence everywhere.
@side(server)
declare interface QuarkRandomGenerator
    --- Integer from minimum to maximum, both inclusive. With one argument from 1 to it.
    method Int(minimum_or_maximum: number, maximum: number?): number
    --- Number from 0 to 1, 0 to maximum or minimum to maximum, the upper end is excluded.
    method Float(minimum_or_maximum: number?, maximum: number?): number
    method Bool(probability: number?): boolean
    --- @return index
    method Pick(list: any[]): (any, number?)
    --- Shuffles in place and returns the list.
    method Shuffle(list: any[]): any[]
    --- Distinct elements without replacement.
    method Sample(list: any[], count: number): any[]
    --- One item picked by weight.
    method Weighted(weights: { [any]: any }): any
    method Normal(mean: number?, deviation: number?): number
    method Exponential(rate: number?): number
    method Poisson(mean: number): number
    method Triangular(minimum: number, maximum: number, mode: number?): number
    --- @return x
    --- @return y
    method InsideCircle(radius: number?): (number, number)
    --- @return x
    --- @return y
    --- @return z
    method InsideSphere(radius: number?): (number, number, number)
    --- @return x
    --- @return y
    --- @return z
    method OnSphere(radius: number?): (number, number, number)
    --- Dice notation like "2d6+3" or "4d6kh3".
    --- @return total
    --- @return rolls
    method Roll(notation: string): (number, number[])
    method GetSeed(): number
    method GetState(): string
    method SetState(state: string): void
    method Clone(): QuarkRandomGenerator
end

@side(server)
declare interface QuarkWeightedPicker
    method Pick(generator: QuarkRandomGenerator?): any
    method PickMany(count: number, generator: QuarkRandomGenerator?): any[]
    method GetProbability(item: any): number
    method GetItems(): { Item: any, Weight: number }[]
    method GetCount(): number
    method GetTotalWeight(): number
end

@side(server)
declare interface QuarkLootTable
