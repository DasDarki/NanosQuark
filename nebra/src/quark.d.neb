    function Capsule(start: Vector | { X: number, Y: number, Z: number? } | number[], finish: Vector | { X: number, Y: number, Z: number? } | number[], radius: number): QuarkShape
    function Prism(points: (Vector | { X: number, Y: number, Z: number? } | number[])[], minimum: number, maximum: number): QuarkShape
