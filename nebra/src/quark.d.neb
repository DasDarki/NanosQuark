--- A request received by an HTTP server.
@side(server)
declare interface QuarkHTTPRequest
    Method: string
    Path: string
    Params: { [string]: string }
    Query: { [string]: string }
    RawQuery: string
    Headers: { [string]: string }
    Body: string
    Cookies: { [string]: string }
    RemoteAddress: string
    IsWebSocket: boolean
    Version: string
    ClientCertificate: QuarkPeerCertificate?
    --- @return message
    method Json(): (any, string?)
    --- @return fields
    --- @return files_or_message
    method Form(): ({ [any]: any }?, { [any]: any } | string?)
    method GetHeader(name: string): string?
end

--- Response of an HTTP handler.
@side(server)
declare interface QuarkHTTPResponse
    method Status(code: number): QuarkHTTPResponse
    method Header(name: string, value: string): QuarkHTTPResponse
    method Json(value: any, status: number?): boolean
    method Text(text: string, status: number?): boolean
    method Html(html: string, status: number?): boolean
    method Send(body: (string | QuarkBuffer)?, content_type: string?, status: number?): boolean
    method Redirect(location: string, status: number?): boolean
    method SendFile(path: string, options: { [string]: any }?): boolean
    method Cookie(name: string, value: string, options: { [string]: any }?): QuarkHTTPResponse
    method ClearCookie(name: string, options: { [string]: any }?): QuarkHTTPResponse
    method Compress(enabled: boolean?): QuarkHTTPResponse
    method IsSent(): boolean
    method GetStatus(): number
end

--- Events: Error(message), Close(reason).
@side(server)
declare interface QuarkHTTPServer extends QuarkConnection
    method Get(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Post(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Put(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Patch(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Delete(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Options(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method All(pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method Route(method: string, pattern: string, handler: (QuarkHTTPRequest, QuarkHTTPResponse) -> void): QuarkHTTPServer
    method WebSocket(pattern: string, handler: (QuarkWebSocket, QuarkHTTPRequest) -> void): QuarkHTTPServer
    method Static(prefix: string, directory: string, options: { [string]: any }?): QuarkHTTPServer
    method Use(middleware: (QuarkHTTPRequest, QuarkHTTPResponse, () -> void) -> void): QuarkHTTPServer
    method GetPort(): number
    method Close(): void
end

