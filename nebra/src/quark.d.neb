    function Union(shapes: QuarkShape[]): QuarkShape
    function IsShape(value: any): boolean
    function PointInPolygon(point: Vector | { [string]: any } | number[], polygon: (Vector | { [string]: any } | number[])[]): boolean
    function PolygonArea(polygon: (Vector | { [string]: any } | number[])[], signed: boolean?): number
    function PolygonCentroid(polygon: (Vector | { [string]: any } | number[])[]): Vector2D
    function ConvexHull(points: (Vector | { [string]: any } | number[])[]): Vector2D[]
