    function MoveTowards(current: number, target: number, step: number): number
    function Round(value: number, decimals: number?): number
    function Sign(value: number): number
    function Wrap(value: number, minimum: number, maximum: number): number
    function NormalizeAngle(angle: number): number
    function DeltaAngle(from: number, to: number): number
    function LerpAngle(from: number, to: number, t: number): number
    function IsNearlyEqual(first: number, second: number, tolerance: number?): boolean
    function Ease(name: string, t: number): number
    function GetEasings(): string[]
    function Tween(from: number | Vector | { X: number, Y: number, Z: number? } | number[], to: number | Vector | { X: number, Y: number, Z: number? } | number[], t: number, easing: string?): number | Vector
    function Bezier(points: (number | Vector | { X: number, Y: number, Z: number? } | number[])[], t: number): number | Vector
    function Spline(points: (number | Vector | { X: number, Y: number, Z: number? } | number[])[], t: number, options: { Closed: boolean?, Alpha: number? }?): number | Vector
    function SampleSpline(points: (number | Vector | { X: number, Y: number, Z: number? } | number[])[], count: number, options: { Closed: boolean?, Alpha: number? }?): (number | Vector)[]
    function Quaternion(x: number?, y: number?, z: number?, w: number?): QuarkQuaternion
    function QuaternionFromRotator(rotator: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[]): QuarkQuaternion
    function QuaternionFromAxisAngle(axis: Vector | { X: number, Y: number, Z: number? } | number[], degrees: number): QuarkQuaternion
    function QuaternionBetween(from: Vector | { X: number, Y: number, Z: number? } | number[], to: Vector | { X: number, Y: number, Z: number? } | number[]): QuarkQuaternion
    function IsQuaternion(value: any): boolean
    function RotateVector(vector: Vector | { X: number, Y: number, Z: number? } | number[], rotation: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[] | QuarkQuaternion): Vector
    function UnrotateVector(vector: Vector | { X: number, Y: number, Z: number? } | number[], rotation: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[] | QuarkQuaternion): Vector
    --- @return forward
    --- @return right
    --- @return up
    function GetDirections(rotation: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[] | QuarkQuaternion): (Vector, Vector, Vector)
    function LookAt(from: Vector | { X: number, Y: number, Z: number? } | number[], to: Vector | { X: number, Y: number, Z: number? } | number[]): Rotator
    function SlerpRotator(from: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[], to: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[], t: number): Rotator
    function CombineRotators(first: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[], second: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[]): Rotator
    function NormalizeRotator(rotator: Rotator | { Pitch: number, Yaw: number, Roll: number? } | number[]): Rotator
    function Sum(values: number[] | QuarkBufferView): number
    function Mean(values: number[] | QuarkBufferView): number?
    function Median(values: number[] | QuarkBufferView): number?
    function Min(values: number[] | QuarkBufferView): number?
    function Max(values: number[] | QuarkBufferView): number?
    function Percentile(values: number[] | QuarkBufferView, percent: number): number?
    function Variance(values: number[] | QuarkBufferView, sample: boolean?): number?
    function StandardDeviation(values: number[] | QuarkBufferView, sample: boolean?): number?
    function Summarize(values: number[] | QuarkBufferView): { Count: number, Sum: number?, Mean: number?, Min: number?, Max: number?, Median: number?, P90: number?, P99: number?, StandardDeviation: number? }
    function Histogram(values: number[] | QuarkBufferView, bins: number, minimum: number?, maximum: number?): number[]
    --- @return message
    function Evaluate(formula: string, variables: ({ [string]: number | boolean })?): (number?, string?)
    --- @return message
    function Compile(formula: string): (QuarkExpression?, string?)
end

--- A 2D or 3D shape.
@side(server)
declare class QuarkShape
    function Contains(point: Vector | { X: number, Y: number, Z: number? } | number[]): boolean
    function RandomPoint(generator: QuarkRandomGenerator?): Vector | Vector2D
    function RandomPoints(count: number, generator: QuarkRandomGenerator?): (Vector | Vector2D)[]
    function ClosestPoint(point: Vector | { X: number, Y: number, Z: number? } | number[]): Vector | Vector2D
    function Distance(point: Vector | { X: number, Y: number, Z: number? } | number[]): number
    --- @return minimum
    --- @return maximum
    function GetBounds(): (Vector | Vector2D, Vector | Vector2D)
    function GetCenter(): Vector | Vector2D
    function GetArea(): number?
    function GetVolume(): number?
    function GetType(): string
    function Is3D(): boolean
end

@side(server)
declare interface QuarkGeometryModule
    function Circle(center: Vector | { X: number, Y: number, Z: number? } | number[], radius: number): QuarkShape
    function Rectangle(center: Vector | { X: number, Y: number, Z: number? } | number[], extent: Vector | { X: number, Y: number, Z: number? } | number[], angle: number?): QuarkShape
    function Polygon(points: (Vector | { X: number, Y: number, Z: number? } | number[])[]): QuarkShape
