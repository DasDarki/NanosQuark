    function QueryRadius(position: Vector | { X: number, Y: number, Z: number? } | number[], radius: number, options: { Limit: number?, WithDistance: boolean? }?): { [any]: any }
    function QueryBox(minimum: Vector | { X: number, Y: number, Z: number? } | number[], maximum: Vector | { X: number, Y: number, Z: number? } | number[]): (number | string)[]
    function FindNearest(position: Vector | { X: number, Y: number, Z: number? } | number[], options: ({ Count: number?, MaxDistance: number?, Exclude: (number | string)?, WithDistance: boolean? })?): { [any]: any }
