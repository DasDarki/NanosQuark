    --- @return allowed
    --- @return retry_after
    --- @return remaining
    function Check(key: any, cost: number?): (boolean, number, number)
    function GetRemaining(key: any): number
    function Reset(key: any): void
    function Clear(): void
    function Prune(): void
    function GetCount(): number
end

