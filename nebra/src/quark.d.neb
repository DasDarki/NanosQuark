@side(server)
declare interface QuarkMetricsRegistry
    method Counter(name: string, help: string?, options: { [string]: any }?): QuarkCounter
    method Gauge(name: string, help: string?, options: { [string]: any }?): QuarkGauge
    method Histogram(name: string, help: string?, options: { [string]: any }?): QuarkHistogram
    method Get(name: string): QuarkCounter | QuarkGauge | QuarkHistogram?
    method Unregister(name: string): boolean
    method Clear(): void
    method Render(): string
    method Expose(server: QuarkHTTPServer, path: string?): QuarkHTTPServer
end

--- Prometheus metrics, functions use the default registry.
@side(server)
declare interface QuarkMetricsModule
    function Counter(name: string, help: string?, options: { [string]: any }?): QuarkCounter
    function Gauge(name: string, help: string?, options: { [string]: any }?): QuarkGauge
    function Histogram(name: string, help: string?, options: { [string]: any }?): QuarkHistogram
    function Get(name: string): QuarkCounter | QuarkGauge | QuarkHistogram?
    function Unregister(name: string): boolean
    function Clear(): void
    function Render(): string
    function Expose(server: QuarkHTTPServer, path: string?): QuarkHTTPServer
    function Registry(): QuarkMetricsRegistry
    function GetDefault(): QuarkMetricsRegistry
end

@side(server)
declare interface QuarkLogger
    method Debug(message: any, fields: { [any]: any }?): void
    method Info(message: any, fields: { [any]: any }?): void
    method Warn(message: any, fields: { [any]: any }?): void
    method Error(message: any, fields: { [any]: any }?): void
    method Log(level: string, message: any, fields: { [any]: any }?): void
    method With(fields: { [any]: any }): QuarkLogger
    method SetLevel(level: string): void
    method GetLevel(): string
    method IsEnabled(level: string): boolean
    method Flush(): void
end

@side(server)
declare interface QuarkLogModule
    function New(options: { [string]: any }?): QuarkLogger
    function Debug(message: any, fields: { [any]: any }?): void
    function Info(message: any, fields: { [any]: any }?): void
    function Warn(message: any, fields: { [any]: any }?): void
    function Error(message: any, fields: { [any]: any }?): void
end

@side(server)
declare interface QuarkWorkerOptions
    Timeout: (number | string)?
    MemoryLimit: number?
end

@side(server)
declare interface QuarkWorkerPool
    --- Calls a global function of the pool code, the last argument has to be the callback.
    method Call(name: string, ...: nil | boolean | number | string | { [any]: any } | ((...(nil | boolean | number | string | { [any]: any })) -> void)): boolean
    method GetSize(): number
    method GetPending(): number
    method Close(): void
end

@side(server)
declare interface QuarkWorkerModule
    function Run(code: string, data: nil | boolean | number | string | { [any]: any }, options: ({ [string]: any } | function)?, callback: nil | ((...(nil | boolean | number | string | { [any]: any })) -> void)): ...any
    --- @return message
    function Pool(code: string, options: { [string]: any }?): (QuarkWorkerPool?, string?)
end

@side(server)
declare Quark: Quark__Static
