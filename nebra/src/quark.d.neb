--- Immutable date with a time zone.
@side(server)
declare class QuarkDateTime
    Year: number
    Month: number
    Day: number
    Hour: number
    Minute: number
    Second: number
    Millisecond: number
    --- 1 is Monday, 7 is Sunday
    Weekday: number
    YearDay: number
    Zone: string
    --- Seconds from UTC
    Offset: number
    operator <(other: QuarkDateTime): boolean
    operator <=(other: QuarkDateTime): boolean
    function GetUnix(): number
    function GetUnixMs(): number
    function ToISO(): string
    function ToRFC2822(): string
    function Format(format: string, options: { Locale: string? }?): string
    function ToTable(): { [any]: any }
    function InZone(zone: string): QuarkDateTime
    function ToUTC(): QuarkDateTime
    function Add(duration: number | string | { Years: number?, Months: number?, Weeks: number?, Days: number?, Hours: number?, Minutes: number?, Seconds: number?, Milliseconds: number? }): QuarkDateTime
    function Subtract(duration: number | string | { Years: number?, Months: number?, Weeks: number?, Days: number?, Hours: number?, Minutes: number?, Seconds: number?, Milliseconds: number? }): QuarkDateTime
    function With(fields: { Year: number?, Month: number?, Day: number?, Hour: number?, Minute: number?, Second: number?, Millisecond: number? }): QuarkDateTime
    function StartOf(unit: string): QuarkDateTime
    function EndOf(unit: string): QuarkDateTime
    --- Milliseconds, or a number in the unit.
    function Since(other: QuarkDateTime, unit: string?): number
    function Relative(now: QuarkDateTime?): string
    function IsBefore(other: QuarkDateTime): boolean
    function IsAfter(other: QuarkDateTime): boolean
end

@side(server)
declare class QuarkCron
    function Next(after: QuarkDateTime?): QuarkDateTime?
