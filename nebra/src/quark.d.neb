    function ClosestPointOnSegment(point: Vector | { [string]: any } | number[], start: Vector | { [string]: any } | number[], finish: Vector | { [string]: any } | number[]): Vector
    function DistanceToSegment(point: Vector | { [string]: any } | number[], start: Vector | { [string]: any } | number[], finish: Vector | { [string]: any } | number[]): number
    function Triangulate(polygon: (Vector | { [string]: any } | number[])[]): number[][]
    function Delaunay(points: (Vector | { [string]: any } | number[])[]): number[][]
    function SimplifyPath(points: (Vector | { [string]: any } | number[])[], tolerance: number): Vector[]
    --- @return minimum
    --- @return maximum
    function BoundingBox(points: (Vector | { [string]: any } | number[])[], options: { [string]: any }?): (Vector?, Vector?)
end

