    function FindWithin(points: (Vector | { X: number, Y: number, Z: number? } | number[])[] | QuarkBufferView, center: Vector | { X: number, Y: number, Z: number? } | number[], radius: number, options: { WithDistance: boolean? }?): { [any]: any }
