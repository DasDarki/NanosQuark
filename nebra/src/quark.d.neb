--- Result of Test.Expect, Not inverts every matcher.
@side(server)
declare class QuarkExpectation
    Not: QuarkExpectation
    function ToBe(expected: any): void
    function ToEqual(expected: any): void
    function ToBeNil(): void
    function ToBeTruthy(): void
    function ToBeFalsy(): void
    function ToBeType(name: string): void
    function ToBeGreaterThan(number: number): void
    function ToBeGreaterThanOrEqual(number: number): void
    function ToBeLessThan(number: number): void
    function ToBeLessThanOrEqual(number: number): void
    function ToBeCloseTo(expected: number, tolerance: number?): void
    function ToContain(item: any): void
    function ToMatch(pattern: string): void
    function ToHaveLength(length: number): void
    function ToThrow(fragment: string?): void
    function ToHaveBeenCalled(): void
    function ToHaveBeenCalledTimes(count: number): void
    function ToHaveBeenCalledWith(...: any): void
end

@side(server)
declare interface QuarkTestingModule
    function Describe(name: string, body: () -> void): void
    function DescribeOnly(name: string, body: () -> void): void
    function DescribeSkip(name: string, body: () -> void): void
    function It(name: string, body: () -> void, options: { Timeout: number? }?): void
    function Test(name: string, body: () -> void, options: { Timeout: number? }?): void
    function Only(name: string, body: () -> void, options: { Timeout: number? }?): void
    function Skip(name: string, body: (() -> void)?, options: { Timeout: number? }?): void
    function BeforeAll(hook: () -> void): void
    function AfterAll(hook: () -> void): void
    function BeforeEach(hook: () -> void): void
    function AfterEach(hook: () -> void): void
    function Expect(value: any): QuarkExpectation
    function Fail(message: string?): void
    function Spy(implementation: function?): function
    function Mock(target: { [any]: any }, key: any, implementation: function?): function
    function GetCalls(spy: function): { [any]: any }[]
    function ResetSpy(spy: function): void
    function SetImplementation(spy: function, implementation: function): void
    function Run(options: { Filter: string?, Timeout: number?, Silent: boolean? }?): QuarkPromise
    function Equal(left: any, right: any): boolean
    function Show(value: any): string
end

--- A regular expression match.
@side(server)
declare interface QuarkRegexMatch
    Text: string
    Start: number
    End: number
    Groups: (string | boolean)[]
    Named: { [string]: string }
end

--- Compiled regular expression.
@side(server)
declare class QuarkRegex
    function IsMatch(text: string, start: number?): boolean
    --- @return start
    --- @return finish
    --- @return text
    function Find(text: string, start: number?): (number?, number?, string?)
    function Match(text: string, start: number?): QuarkRegexMatch?
    function MatchAll(text: string, limit: number?): QuarkRegexMatch[]
    --- @return count
    function Replace(text: string, replacement: string | { [any]: any } | ((QuarkRegexMatch) -> string?), limit: number?): (string, number)
    function Split(text: string, limit: number?): string[]
    function Count(text: string): number
    function GetPattern(): string
    function GetGroupCount(): number
    function GetGroupNames(): string[]
end

@side(server)
declare interface QuarkRegexModule
    --- @return message
    function New(pattern: string, options: { CaseInsensitive: boolean?, Multiline: boolean?, DotAll: boolean?, Extended: boolean?, Ascii: boolean? }?): (QuarkRegex?, string?)
    function IsValid(pattern: string): boolean
    function Escape(text: string): string
    function IsMatch(pattern: string, text: string, start: number?): boolean
    --- @return start
    --- @return finish
    --- @return text
    function Find(pattern: string, text: string, start: number?): (number?, number?, string?)
    function Match(pattern: string, text: string, start: number?): QuarkRegexMatch?
    function MatchAll(pattern: string, text: string, limit: number?): QuarkRegexMatch[]
    --- @return count
    function Replace(pattern: string, text: string, replacement: string | { [any]: any } | ((QuarkRegexMatch) -> string?), limit: number?): (string, number)
    function Split(pattern: string, text: string, limit: number?): string[]
end

@side(server)
declare class QuarkWordFilter
    function Contains(text: string): boolean
    function Find(text: string): { Word: string, Text: string, Start: number, End: number }[]
    --- @return count
    function Censor(text: string, replacement: string?): (string, number)
    function Add(words: string[]): void
    function Remove(words: string[]): void
    function GetWords(): string[]
end

--- Unicode aware text helpers.
@side(server)
declare interface QuarkTextModule
    function Upper(text: string): string
    function Lower(text: string): string
    function Capitalize(text: string): string
    function ToAscii(text: string): string
    function Reverse(text: string): string
    function Trim(text: string): string
    function Normalize(text: string, form: string?): string
    function Slugify(text: string, separator: string?): string
    function IsValid(text: string): boolean
    function Length(text: string): number
    function Graphemes(text: string): string[]
    function Words(text: string): string[]
    function Sub(text: string, start: number, finish: number?): string
    function Truncate(text: string, length: number, suffix: string?): string
    function Split(text: string, separator: string, options: { Trim: boolean?, RemoveEmpty: boolean?, Limit: number? }?): string[]
    function Pad(text: string, width: number, options: { Align: string?, Char: string? }?): string
    function Wrap(text: string, width: number): string[]
    function Levenshtein(first: string, second: string): number
    function DamerauLevenshtein(first: string, second: string): number
    function Similarity(first: string, second: string, algorithm: string?): number
    function FuzzyFind(query: string, list: any[], options: { Threshold: number?, Limit: number?, Key: string?, CaseSensitive: boolean? }?): { Item: any, Score: number, Index: number }[]
