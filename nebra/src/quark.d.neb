@side(server)
declare interface QuarkTimeModule
    function Now(zone: string?): QuarkDateTime
    function Date(fields: { Year: number, Month: number?, Day: number?, Hour: number?, Minute: number?, Second: number?, Millisecond: number? }, zone: string?): QuarkDateTime
    function FromUnix(seconds: number, zone: string?): QuarkDateTime
    function FromUnixMs(milliseconds: number, zone: string?): QuarkDateTime
    --- @return message
    function Parse(text: string, options: { Zone: string?, Format: string? }?): (QuarkDateTime?, string?)
    function Unix(): number
    function UnixMs(): number
    function IsDateTime(value: any): boolean
    function IsValidZone(name: string): boolean
    function GetZones(): string[]
    function GetSystemZone(): string
    --- @return message
