    function GetNeighbors(id: number | string): ({ ID: number | string, Cost: number })[]
    --- @return distance
    function FindNearest(position: Vector | { X: number, Y: number, Z: number? } | number[]): ((number | string)?, number?)
    --- @return cost_or_message
    function FindPath(from: number | string, to: number | string, options: { Heuristic: boolean? }?, callback: function?): (((number | string)[])?, number | string?)
    function GetDistances(from: number | string, max_cost: number?): { [number | string]: number }
end

@side(server)
declare interface QuarkPathfindingModule
    function Grid(width: number, height: number, options: ({ Diagonal: boolean?, CornerCutting: boolean?, CellSize: number?, Origin: (Vector | { X: number, Y: number, Z: number? } | number[])? })?): QuarkGrid
    function Graph(): QuarkGraph
end

@side(server)
declare class QuarkSpatialHash
    function Set(id: number | string, position: Vector | { X: number, Y: number, Z: number? } | number[]): void
    function Remove(id: number | string): boolean
    function Has(id: number | string): boolean
