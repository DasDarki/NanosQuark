@side(server)
declare interface QuarkRandomModule
    --- Integer from minimum to maximum, both inclusive. With one argument from 1 to it.
    function Int(minimum_or_maximum: number, maximum: number?): number
    --- Number from 0 to 1, 0 to maximum or minimum to maximum, the upper end is excluded.
    function Float(minimum_or_maximum: number?, maximum: number?): number
