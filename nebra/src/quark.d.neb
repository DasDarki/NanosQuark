    function GetDirections(rotation: Rotator | { [string]: any } | number[] | QuarkQuaternion): (Vector, Vector, Vector)
    function LookAt(from: Vector | { [string]: any } | number[], to: Vector | { [string]: any } | number[]): Rotator
    function SlerpRotator(from: Rotator | { [string]: any } | number[], to: Rotator | { [string]: any } | number[], t: number): Rotator
    function CombineRotators(first: Rotator | { [string]: any } | number[], second: Rotator | { [string]: any } | number[]): Rotator
    function NormalizeRotator(rotator: Rotator | { [string]: any } | number[]): Rotator
    function Sum(values: number[] | QuarkBufferView): number
    function Mean(values: number[] | QuarkBufferView): number?
    function Median(values: number[] | QuarkBufferView): number?
    function Min(values: number[] | QuarkBufferView): number?
    function Max(values: number[] | QuarkBufferView): number?
    function Percentile(values: number[] | QuarkBufferView, percent: number): number?
    function Variance(values: number[] | QuarkBufferView, sample: boolean?): number?
    function StandardDeviation(values: number[] | QuarkBufferView, sample: boolean?): number?
    function Summarize(values: number[] | QuarkBufferView): { Count: number, Sum: number?, Mean: number?, Min: number?, Max: number?, Median: number?, P90: number?, P99: number?, StandardDeviation: number? }
    function Histogram(values: number[] | QuarkBufferView, bins: number, minimum: number?, maximum: number?): number[]
    --- @return message
    function Evaluate(formula: string, variables: ({ [string]: number | boolean })?): (number?, string?)
    --- @return message
    function Compile(formula: string): (QuarkExpression?, string?)
end

--- A 2D or 3D shape.
