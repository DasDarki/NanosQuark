--- Redis client, every method takes an optional callback as last argument.
@side(server)
declare interface QuarkRedisClient
    --- Any Redis command.
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    method Command(name: string, ...: any): (any, string?)
    --- @return message
    method Get(key: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    method Set(key: string | number | QuarkBuffer, value: string | number | QuarkBuffer, options: { [string]: any }?, callback: function?): (boolean?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    method Delete(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    method Exists(key: string | number | QuarkBuffer, callback: function?): (boolean?, string?)
    --- @return message
    method Expire(key: string | number | QuarkBuffer, seconds: number, callback: function?): (boolean?, string?)
    --- @return message
    method TTL(key: string | number | QuarkBuffer, callback: function?): (number?, string?)
    --- @return message
    method Increment(key: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @return message
    method Decrement(key: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @return message
    method HashGet(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, callback: function?): (string?, string?)
    --- @return message
    method HashSet(key: string | number | QuarkBuffer, field_or_fields: string | number | QuarkBuffer | { [any]: any }, value: (string | number | QuarkBuffer)?, callback: function?): (number?, string?)
    --- @return message
    method HashGetAll(key: string | number | QuarkBuffer, callback: function?): ({ [string]: string }?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    method HashDelete(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @return message
    method HashExists(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, callback: function?): (boolean?, string?)
    --- @return message
    method HashIncrement(key: string | number | QuarkBuffer, field: string | number | QuarkBuffer, by: number?, callback: function?): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
    method ListPush(key: string | number | QuarkBuffer, ...: any): (number?, string?)
    --- @param ... Arguments, optionally followed by a callback
    --- @return message
